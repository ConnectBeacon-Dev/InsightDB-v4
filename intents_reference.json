{
  "version": "2.0",
  "description": "Simplified intent patterns - only classification and location filters. Everything else uses semantic search.",
  "last_updated": "2025-10-13",
  
  "classification_based_intents": {
    "ownership_type": {
      "description": "Queries about company ownership using ETL classification: is_government_company, is_private_company",
      "patterns": [
        {
          "keywords": ["government company", "govt company", "public sector", "PSU"],
          "filter_type": "government",
          "etl_column": "is_government_company",
          "examples": [
            "Government companies in Karnataka",
            "List of PSUs in India",
            "Public sector companies in Mumbai"
          ]
        },
        {
          "keywords": ["union government", "central government", "central PSU"],
          "filter_type": "union_government",
          "etl_column": "is_union_government",
          "examples": [
            "Union government companies",
            "Central government PSUs in Delhi"
          ]
        },
        {
          "keywords": ["state government", "state PSU"],
          "filter_type": "state_government",
          "etl_column": "is_state_government",
          "examples": [
            "State government companies in Karnataka",
            "State PSUs"
          ]
        },
        {
          "keywords": ["private company", "private sector"],
          "filter_type": "private",
          "etl_column": "is_private_company",
          "examples": [
            "Private companies in Bangalore",
            "Private sector companies"
          ]
        }
      ]
    },
    
    "company_size": {
      "description": "Queries about company size using ETL classifications: is_msme, company_size_category",
      "patterns": [
        {
          "keywords": ["MSME", "micro small medium", "SME"],
          "filter_type": "msme",
          "etl_column": "is_msme",
          "examples": [
            "MSME companies in Pune",
            "List of MSMEs in India",
            "Small and medium enterprises"
          ]
        },
        {
          "keywords": ["micro enterprise", "micro company"],
          "filter_type": "company_size",
          "size_value": "Micro",
          "etl_column": "company_size_category",
          "examples": ["Micro companies in Delhi"]
        },
        {
          "keywords": ["small enterprise", "small company"],
          "filter_type": "company_size",
          "size_value": "Small",
          "etl_column": "company_size_category",
          "examples": ["Small companies in Maharashtra"]
        },
        {
          "keywords": ["medium enterprise", "medium company"],
          "filter_type": "company_size",
          "size_value": "Medium",
          "etl_column": "company_size_category",
          "examples": ["Medium scale companies"]
        },
        {
          "keywords": ["large company", "large enterprise"],
          "filter_type": "company_size",
          "size_value": "Large",
          "etl_column": "company_size_category",
          "examples": ["Large companies in India"]
        }
      ]
    },
    
    "listing_status": {
      "description": "Queries about stock listing using ETL classification: is_listed_company",
      "patterns": [
        {
          "keywords": ["listed company", "publicly traded", "stock listed"],
          "filter_type": "listed",
          "etl_column": "is_listed_company",
          "examples": [
            "Listed companies in India",
            "Publicly traded companies in Mumbai"
          ]
        }
      ]
    },
    
    "company_status": {
      "description": "Queries about company active status using ETL classification: is_active_company",
      "patterns": [
        {
          "keywords": ["active company"],
          "filter_type": "active",
          "etl_column": "is_active_company",
          "examples": ["Active companies in Karnataka"]
        }
      ]
    }
  },
  
  "location_filters": {
    "description": "Location-based filtering (State, City)",
    "major_states": [
      "Maharashtra", "Karnataka", "Tamil Nadu", "Gujarat", "Delhi", 
      "Telangana", "Uttar Pradesh", "West Bengal", "Rajasthan", 
      "Madhya Pradesh", "Kerala", "Punjab", "Haryana", "Andhra Pradesh"
    ],
    "major_cities": [
      "Mumbai", "Bangalore", "Delhi", "Chennai", "Hyderabad", "Pune", 
      "Kolkata", "Ahmedabad", "Surat", "Jaipur", "Lucknow", "Kanpur",
      "Nagpur", "Indore", "Thane", "Bhopal", "Visakhapatnam", "Vadodara"
    ],
    "pattern": "\\b(?:in|from|at|based in)\\s+([a-zA-Z\\s]+)",
    "examples": [
      "Companies in Bangalore",
      "IT companies in Pune",
      "Government companies in Karnataka"
    ]
  },
  
  "supported_query_types": {
    "description": "Query types handled by this simplified intent handler",
    "csv_filters": [
      "Classification filters (government, MSME, listed, private, active)",
      "Location filters (companies in specific city/state)",
      "Combined classification + location"
    ],
    "semantic_search": [
      "Company attribute queries (address, contact, PAN, etc.)",
      "Industry-specific queries (drone companies, ship manufacturing, etc.)",
      "Product queries (consumable products, products to HAL, etc.)",
      "Facility queries (test facilities, R&D facilities, etc.)",
      "Certification queries (ISO 9001, etc.)",
      "Research queries (advanced materials, etc.)",
      "Any complex or ambiguous queries"
    ],
    "examples": {
      "csv_filter": [
        "Government companies in Karnataka",
        "MSME companies in Pune",
        "Companies in Bhopal",
        "Listed companies in India"
      ],
      "semantic_search": [
        "Address of FLONEX OIL TECHNOLOGIES",
        "Contact details of ABC Corp",
        "Drone manufacturing companies",
        "Companies with ISO 9001 certification",
        "Test facility for chemical testing"
      ]
    }
  },
  
  "notes": {
    "version_2_changes": "Simplified to only handle classification and location filters. Removed attribute query detection and industry filters to reduce complexity and false matches.",
    "design_philosophy": "Keep intent handler simple and reliable. Use CSV filters only for high-value, low-risk patterns. Default to semantic search for everything else.",
    "csv_filters": "Fast and precise for classification (government, MSME, etc.) and pure location queries",
    "semantic_search": "Flexible and robust for all other queries including attributes, products, facilities, certifications",
    "maintenance": "Fewer patterns = fewer bugs. Semantic search handles edge cases naturally without fragile pattern matching."
  }
}
